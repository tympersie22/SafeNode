{
  "name": "safenode-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "prebuild": "node scripts/write-release-version.mjs",
    "build": "vite build --configLoader native",
    "cap:copy": "npm run cap:copy:android",
    "cap:copy:android": "npx cap copy android",
    "cap:copy:ios": "npx cap copy ios",
    "cap:sync": "npm run cap:sync:android",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "build:android:apk": "npm run build && npm run cap:copy:android && cd android && ./gradlew assembleDebug",
    "build:ios:simulator": "VITE_API_URL=${VITE_API_URL:-https://api.safe-node.app} VITE_MOBILE_API_URL=${VITE_MOBILE_API_URL:-https://api.safe-node.app} npm run build && npm run cap:copy:ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "build:ios:simulator:tunnel": "test -n \"$VITE_MOBILE_API_URL\" || (echo 'VITE_MOBILE_API_URL must be an HTTPS tunnel URL' && exit 1); VITE_API_URL=$VITE_MOBILE_API_URL npm run build && npm run cap:copy:ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "preview": "vite preview --configLoader runner",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@sentry/react": "^10.26.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "hash-wasm": "^4.11.0",
    "lucide-react": "^0.554.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.13"
  },
  "overrides": {
    "rollup": "^4.59.0"
  }
}
