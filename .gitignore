.codex-backups/

# --- Security: never commit env dumps / secret exports ---
# (added during P0 secret-leak remediation)
railway-*.txt
vercel-*.txt
*-env*.txt
*.env.txt
secrets*.txt
PRODUCTION_SECRETS.*

# Test env (local-only, safe to commit)
!.env.test
!backend/.env.test
