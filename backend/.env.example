# Safenode Backend Environment Variables
PORT=4000
NODE_ENV=development

# Sentry error tracking (required in production to enable reporting)
SENTRY_DSN=

# API Configuration
API_URL=http://localhost:4000
HIBP_API_URL=https://api.pwnedpasswords.com
HIBP_USER_AGENT=Safenode/0.1.0

# Security
CORS_ORIGIN=http://localhost:5173
# Comma-separated WebAuthn origins. Native Android uses android:apk-key-hash:<release-cert-sha256-base64url>.
# WEBAUTHN_ORIGIN=https://safe-node.app,android:apk-key-hash:...
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Database (for future use)
DATABASE_URL=postgresql://localhost:5432/safenode
# Optional Supabase-compatible Postgres fallback vars:
# Dedicated pooler (recommended):
# POSTGRES_PRISMA_URL=postgres://postgres:[YOUR-PASSWORD]@db.ohzfyxtxffvnzyhkaihs.supabase.co:6543/postgres?sslmode=require
# POSTGRES_URL_NON_POOLING=postgres://...:5432/postgres?sslmode=require
# POSTGRES_URL=postgres://...:6543/postgres?sslmode=require
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stripe (required for billing)
BILLING_PROVIDER=paddle
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
STRIPE_PRICE_INDIVIDUAL_ANNUAL=price_...
STRIPE_PRICE_FAMILY_MONTHLY=price_...
STRIPE_PRICE_FAMILY_ANNUAL=price_...
STRIPE_PRICE_TEAMS_MONTHLY=price_...
STRIPE_PRICE_TEAMS_ANNUAL=price_...
# Optional backward compatibility:
# STRIPE_PRICE_INDIVIDUAL=price_...
# STRIPE_PRICE_FAMILY=price_...
# STRIPE_PRICE_TEAMS=price_...

# Paddle (recommended global provider)
PADDLE_API_KEY=pdl_live_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRICE_INDIVIDUAL_MONTHLY=pri_...
PADDLE_PRICE_INDIVIDUAL_ANNUAL=pri_...
PADDLE_PRICE_FAMILY_MONTHLY=pri_...
PADDLE_PRICE_FAMILY_ANNUAL=pri_...
PADDLE_PRICE_TEAMS_MONTHLY=pri_...
PADDLE_PRICE_TEAMS_ANNUAL=pri_...

# Email (pick one provider)
RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG...
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=Safenode <noreply@safe-node.app>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
# Optional: force OAuth callback base URL (recommended in production)
# SSO_CALLBACK_BASE_URL=https://safe-node.app

# Apple Sign In
# Service ID / client ID created in Apple Developer
APPLE_CLIENT_ID=com.safenode.web
# Apple Developer team identifier
APPLE_TEAM_ID=
# Sign in with Apple private key identifier
APPLE_KEY_ID=
# .p8 private key content with literal \n escapes when stored as a platform secret
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Canonical web origin used for browser-to-desktop PKCE approval.
DESKTOP_AUTH_WEB_ORIGIN=https://safe-node.app
