{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Minimal permissions for the Safenode desktop preview",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://safe-node.app/*"
        }
      ]
    }
  ]
}
