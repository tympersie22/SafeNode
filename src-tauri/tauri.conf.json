{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Safenode",
  "mainBinaryName": "Safenode",
  "version": "0.1.0",
  "identifier": "com.safenode.desktop",
  "build": {
    "beforeDevCommand": "bash src-tauri/scripts/dev-frontend.sh",
    "beforeBuildCommand": "bash src-tauri/scripts/build-frontend.sh",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        "desktop"
      ],
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ipc: http://ipc.localhost https://api.safe-node.app https://*.sentry.io; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Safenode",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Passkey-first secure identity and encrypted vault",
    "longDescription": "Safenode combines passkey-first identity, zero-knowledge vault encryption, recovery, and team secrets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
